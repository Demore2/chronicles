    "generate:notification-icon": "node scripts/generate-notification-icon.mjs",
    "check:listing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-listing-lengths.mjs",
    "audit:interactief": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-interactive-content.mjs",
    "generate:interactief": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-interactive-content.mjs",
    "generate:batch": "node orchestration-controller.mjs",
    "generate:batch:dev": "node orchestration-controller.mjs",
    "generate:batch:validate": "npm run validate:content && npx tsc --noEmit && npm run lint",
    "sync:verhaalcatalogus": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-story-catalog.mjs",
    "check:push": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-push-setup.mjs"
  },
  "private": true
