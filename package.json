  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas": "npx --yes eas-cli@^21.4.0",
    "build:android:preview": "npm run eas -- build --profile preview --platform android",
    "build:android:prod": "npm run eas -- build --profile production --platform android",
    "submit:android": "npm run eas -- submit --profile internal --platform android",
    "submit:android:prod": "npm run eas -- submit --profile production --platform android",
    "generate:map-data": "node scripts/generate-map-data.mjs",
    "validate:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-content.mjs",
    "content:read-times": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/recalculate-read-times.mjs",
    "generate:images:r9": "node scripts/generate-portrait-images.mjs",
    "generate:images:scenes": "node scripts/generate-scene-images.mjs",
