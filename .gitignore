# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Google Play service-account key used by `eas submit` (see eas.json ->
# submit.*.android.serviceAccountKeyPath). Never commit this.
play-service-account.json

# build artefacts downloaded from EAS (108 MB per AAB) — de bron is de build op
# expo.dev, niet het bestand dat hier toevallig staat
*.aab
*.apk

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local scratch output from ad-hoc `expo export` checks
.tmp-export-check*

# scratch output from the asset scripts and screenshot sessions: the source of
# truth is the SVG/HTML the script reads, not what it happened to spit out here
.tmp-notification-icon.html
.tmp-shots/

# personal Claude Code permission cache (machine-specific)
.claude/settings.local.json

# portable Git-for-Windows toolchain installed inside this folder on this
# machine (this is literally what `git.exe` resolves to here) — not project
# source, must never be committed
/Git/
# EAS build cache
.agents
# testaccountgegevens: platte wachtwoorden, en docs/ wordt via GitHub Pages
# publiek geserveerd vanuit een publieke repo — dit bestand mag nooit gecommit worden
docs/TEST_ACCOUNTS.md
